# Zuri Connect Africa — frontend environment template.
#
# WARNING: Every VITE_* variable below is shipped to every browser. Only put
# values here that are safe for the public. Server secrets (service-role keys,
# Daraja credentials, OTP_PEPPER, PIN_PEPPER, AI provider keys, webhook
# secrets, Africa's Talking API keys) belong in Supabase Edge Function
# secrets — never in this file.
#
# See SETUP.md for the deployment checklist.

# Public Supabase project URL.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Public anon key (NOT the service-role key). Rotate immediately if leaked.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App environment: local | demo | development | staging | production.
VITE_APP_ENV=development

# Required to be "true" in production / staging. Boots fail closed otherwise.
VITE_STRICT_ENV=false

# Allow browser-side demo bypasses. MUST stay "false" / unset in production /
# staging — even if set to true here, the boot validator refuses it.
VITE_ALLOW_CLIENT_DEMO_CONTROLS=false

# When set to 'true', exposes internal admin/diagnostic pages
# (SecurityOperationsCenter, AdminSecurityDashboard, Bonga).
# MUST remain unset/false for any pitch or staging deploy.
VITE_ALLOW_INTERNAL_PAGES=false
