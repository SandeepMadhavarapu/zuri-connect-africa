# Copy to .env.local (or CI secrets) for staging — never commit real keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional: set to false to disable demo fallback (idempotency prefix, demo boot metric) when Supabase is unset
# VITE_DEMO_FALLBACK=false

# Optional HTTPS API base (validated in strict/staging/production when non-empty)
# VITE_API_BASE_URL=https://api.example.com

# Optional: Vitest live Supabase staging integration (tests/integration/supabase-staging.test.js)
SUPABASE_STAGING_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_STAGING_ANON_KEY=your_anon_key
SUPABASE_STAGING_TEST_EMAIL=staging-qa@example.com
SUPABASE_STAGING_TEST_PASSWORD=your_staging_password
